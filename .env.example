# =============================================================================
# FormEase (integriti-forms) - environment configuration
#
# Loaded by web/env.js via dotenv from the REPO ROOT (this file's directory).
# Copy to `.env` and fill in the blanks:   cp .env.example .env
#
# Legend:  [required]  app will not work without it
#          [optional]  has a safe default, listed as "default: ..."
# =============================================================================


# -----------------------------------------------------------------------------
# Shopify app credentials
#
# From the Shopify Partners dashboard > your app > "Client credentials".
# web/env.js maps CLIENT_ID -> SHOPIFY_API_KEY and CLIENT_SECRET ->
# SHOPIFY_API_SECRET, so setting the CLIENT_* pair is enough. `shopify app dev`
# injects SHOPIFY_API_KEY / SHOPIFY_API_SECRET itself and those win if present.
# -----------------------------------------------------------------------------

# [required] Public client ID / API key. Must match client_id in shopify.app.toml.
CLIENT_ID=

# [required] Client secret. Also signs app proxy requests (web/middleware/verifyAppProxy.js)
# and is the fallback encryption key. Never commit the real value.
CLIENT_SECRET=

# [optional] Set these only if you are NOT using CLIENT_ID / CLIENT_SECRET above.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=

# [optional] Comma-separated access scopes. Keep in sync with shopify.app.toml.
# default: write_app_proxy,read_products
SCOPES=write_app_proxy,read_products

# [optional] Public HTTPS URL of this app (no trailing slash). HOST and
# SHOPIFY_APP_URL are interchangeable - env.js copies whichever one is set into
# the other. Must match application_url in shopify.app.toml.
# default: https://formease.integritistudio.us
SHOPIFY_APP_URL=

# [optional] App handle, used to build Shopify managed-pricing URLs.
# Must match `handle` in shopify.app.toml.
# default: formease
SHOPIFY_APP_HANDLE=formease

# [optional] Adds a custom shop domain to the allowed list. Read directly by
# @shopify/shopify-app-express (sets api.customShopDomains), not by app code -
# only needed if you develop against a non-myshopify shop domain.
# SHOP_CUSTOM_DOMAIN=

# [optional] App identifier sent in outbound portal webhook payloads.
# default: falls back to SHOPIFY_API_KEY, then CLIENT_ID
# SHOPIFY_APP_ID=


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# [optional] Port the Express backend listens on. PORT is the fallback.
# default: 3000
BACKEND_PORT=3000
# PORT=3000

# [optional] Vite dev-server port. Set automatically by `shopify app dev`;
# only needed if you run the frontend dev server by hand.
# FRONTEND_PORT=

# [optional] `production` serves the built frontend from frontend/dist.
# default: unset (development). npm scripts set this for you.
# NODE_ENV=production


# -----------------------------------------------------------------------------
# PostgreSQL
#
# Backs both the app tables (web/db) and Shopify session storage (web/shopify.js).
# Every value has a default, but they are local-dev defaults - set them explicitly
# for anything real.
# -----------------------------------------------------------------------------

# default: localhost
DB_HOST=localhost
# default: 5432
DB_PORT=5432
# default: postgres
DB_USERNAME=postgres
# default: "" (empty)
DB_PASSWORD=
# default: shopify-app
DB_NAME=shopify-app


# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------

# [required in production] AES-256-GCM key for per-shop SMTP passwords at rest
# (web/lib/encryption.js). The raw string is SHA-256 hashed into the key, so any
# length works - use something long and random:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Falls back to CLIENT_SECRET, then the literal "dev-fallback-key". Changing this
# value makes previously encrypted SMTP passwords undecryptable.
ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# File storage - Cloudflare R2 (S3-compatible)
#
# Powers file-upload form fields (web/services/storage.js). Optional: leave blank
# and the app runs, but file uploads are disabled. Each setting accepts several
# names; the R2_* spelling is preferred and the others are legacy fallbacks.
# -----------------------------------------------------------------------------

# [required for uploads] S3 API endpoint.
# Fallbacks: CLOUDFLARE_S3_API, S3_API_KEY
# If you set R2_ACCOUNT_ID instead, the endpoint is derived as
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# [optional] Cloudflare account ID, used only to derive the endpoint above.
# R2_ACCOUNT_ID=

# [required for uploads] Fallbacks: S3_ACCESS_KEY_ID, AWS_ACCESS_KEY_ID
R2_ACCESS_KEY_ID=

# [required for uploads] Fallbacks: S3_SECRET_ACCESS_KEY, AWS_SECRET_ACCESS_KEY
R2_SECRET_ACCESS_KEY=

# [optional] Bucket name. A bucket path inside R2_ENDPOINT overrides this.
# default: integriti-forms
R2_BUCKET=integriti-forms


# -----------------------------------------------------------------------------
# Integriti portal data webhooks
#
# Outbound install / uninstall / affiliate / billing events (web/services/data-webhooks.js).
# Optional: if DATAWEBHOOK_URL or WEBHOOK_SECRET is blank, these calls are skipped
# and logged rather than failing the request.
#
# NOTE: the four *_URL values below are PATHS appended to DATAWEBHOOK_URL,
# not absolute URLs.
# -----------------------------------------------------------------------------

# [required for portal sync] Base URL of the portal, no trailing slash.
DATAWEBHOOK_URL=

# [required for portal sync] Shared secret. Sent as X-Webhook-Secret and used to
# HMAC-sign the body as X-Shopify-Hmac-Sha256.
WEBHOOK_SECRET=

# [optional] Endpoint paths, relative to DATAWEBHOOK_URL.
APP_INSTALL_URL=
APP_UNINSTALL_URL=
AFFILIATE_URL=
BILLING_URL=


# -----------------------------------------------------------------------------
# Billing
# -----------------------------------------------------------------------------

# [optional] Test-mode subscriptions. Any value other than the exact string
# "false" means test mode, so you MUST set it to false in production to charge
# real money (web/routes/billing.js).
# default: true (test charges)
BILLING_TEST=true
